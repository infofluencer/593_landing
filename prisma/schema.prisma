generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  team
  client
}

enum Provider {
  google
  meta
}

enum TenantType {
  ecommerce
  lead
}

enum AlertSeverity {
  ok
  warn
  critical
  unknown
}

enum ConversionKind {
  whatsapp
  form
  sale
  other
}

enum SyncStatus {
  pending
  running
  success
  error
}

/// provider = API returned the metric; derived = we computed (e.g. CPA = spend/conv).
enum MetricOrigin {
  provider
  derived
}

/// Playwright site tag check — GTM config ≠ tags firing on site.
enum SiteVerifyStatus {
  not_tested
  pass
  fail
  partial
  unknown
  error
}

enum BoardCardPriority {
  low
  normal
  high
  urgent
}

/// Agency-level OAuth / system-user (one row per provider).
/// Tokens NEVER stored raw — secret-store reference only.
model AgencyConnection {
  id              String   @id @default(cuid())
  provider        Provider @unique
  oauthTokenRef   String
  loginCustomerId String?
  businessId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Brand sourced from Meta BM ad accounts (metaAccountId = source of truth).
/// type drives conversion model + which sections render.
model Tenant {
  id            String     @id @default(cuid())
  slug          String     @unique
  name          String
  website       String?
  metaAccountId String     @unique
  type          TenantType @default(lead)
  timezone      String     @default("Europe/Istanbul")
  currency      String     @default("TRY")
  visible       Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  mapping         TenantMapping?
  thresholds      TenantThreshold?
  siteVerification SiteVerification?
  memberships     Membership[]
  metaInsights    MetaInsight[]
  metaAds         MetaAd[]
  metaAdInsights  MetaAdInsight[]
  metaAdsetInsights MetaAdsetInsight[]
  metaBreakdowns  MetaBreakdownInsight[]
  googleAdsMetrics GoogleAdsMetric[]
  billingCharges  BillingCharge[]
  ga4Metrics      Ga4Metric[]
  conversions     Conversion[]
  alerts          Alert[]
  syncJobs        SyncJob[]
  boardCards      BoardCard[]
}

model TenantThreshold {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  budgetPaceWarnPct Int      @default(85)
  convDropoutDays   Int      @default(3)
  minSpendForAlert  Decimal  @default(100) @db.Decimal(14, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Playwright site verification (consent scenarios). Last run only.
model SiteVerification {
  id        String           @id @default(cuid())
  tenantId  String           @unique
  status    SiteVerifyStatus @default(not_tested)
  checkedAt DateTime?
  summary   String?
  /// Per-scenario results: default / accept / reject
  scenarios Json             @default("[]")
  findings  Json             @default("{}")
  error     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Google stack mapped onto a Meta-sourced tenant (nullable = eksik bağlantı).
model TenantMapping {
  id             String  @id @default(cuid())
  tenantId       String  @unique
  adsCustomerId  String?
  ga4PropertyId  String?
  gtmContainerId String?
  gscSiteUrl     String?
  merchantId     String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  /// Staff-only recoverable copy for agency settings (auth still uses passwordHash).
  passwordPlain String?
  name         String?
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships      Membership[]
  assignedAlerts   Alert[]      @relation("AlertAssignee")
  teamMemberships  TeamMember[]
  cardAssignments  BoardCardAssignee[]
  createdCards     BoardCard[]  @relation("CardCreator")
  cardActivities   BoardCardActivity[]
}

/// Ajans içi ekip (yalnızca admin/team staff). Üye çoka-çok (TeamMember).
model Team {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  /// Kanban filtre / rozet rengi (hex).
  color       String   @default("#71717a")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members TeamMember[]
  cards   BoardCard[]
}

/// TeamMembership — bir kullanıcı birden fazla takımda olabilir.
model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

/// Ajans durum tablosu (Trello tarzı) — tek board, yalnızca staff host.
model Board {
  id        String   @id @default(cuid())
  name      String   @default("Ajans durumu")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  columns BoardColumn[]
}

model BoardColumn {
  id       String @id @default(cuid())
  boardId  String
  name     String
  position Int
  /// Tailwind-friendly accent hex, e.g. #e91825
  color    String?

  board Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards BoardCard[]

  @@index([boardId, position])
}

model BoardCard {
  id            String            @id @default(cuid())
  columnId      String
  title         String
  description   String?
  position      Int
  priority      BoardCardPriority @default(normal)
  /// Kart hangi takıma ait (filtre / grup).
  teamId        String?
  tenantId      String?
  dueAt         DateTime?
  labels        String[]          @default([])
  sourceAlertId String?
  createdById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  column      BoardColumn         @relation(fields: [columnId], references: [id], onDelete: Cascade)
  team        Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy   User?               @relation("CardCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tenant      Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  sourceAlert Alert?              @relation(fields: [sourceAlertId], references: [id], onDelete: SetNull)
  assignees   BoardCardAssignee[]
  activities  BoardCardActivity[]

  @@index([columnId, position])
  @@index([teamId])
  @@index([tenantId])
  @@index([sourceAlertId])
  @@index([dueAt])
}

/// Kart ↔ staff çoklu atama.
model BoardCardAssignee {
  id        String   @id @default(cuid())
  cardId    String
  userId    String
  createdAt DateTime @default(now())

  card BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cardId, userId])
  @@index([userId])
}

/// Kart durum / atama değişiklikleri (salt okuma audit).
model BoardCardActivity {
  id        String   @id @default(cuid())
  cardId    String
  actorId   String?
  /// created | moved | assigned | unassigned | priority | due | labels | team | tenant | updated
  type      String
  message   String?
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  card  BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  actor User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([cardId, createdAt])
}

model Membership {
  id       String @id @default(cuid())
  userId   String
  tenantId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

/// Meta Marketing API insights (paid only — no Instagram organic).
model MetaInsight {
  id          String   @id @default(cuid())
  tenantId    String
  date        DateTime @db.Date
  campaignId  String   @default("")
  campaignName String  @default("")
  objective   String   @default("")
  spend       Decimal  @default(0) @db.Decimal(14, 2)
  impressions Int      @default(0)
  reach       Int      @default(0)
  frequency   Decimal? @db.Decimal(10, 4)
  clicks      Int      @default(0)
  ctr         Decimal? @db.Decimal(10, 6)
  cpc         Decimal? @db.Decimal(14, 4)
  /// action_type → count map (purchase, lead, messaging_…, etc.)
  actions     Json     @default("{}")
  /// action_type → value map (purchase value etc.)
  actionValues Json    @default("{}")
  conversions Decimal? @db.Decimal(14, 4)
  convValue   Decimal? @db.Decimal(14, 2)
  cpa         Decimal? @db.Decimal(14, 4)
  roas        Decimal? @db.Decimal(14, 4)
  ctrOrigin   MetricOrigin @default(provider)
  cpcOrigin   MetricOrigin @default(provider)
  cpaOrigin   MetricOrigin @default(derived)
  roasOrigin  MetricOrigin @default(provider)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, campaignId, objective])
  @@index([tenantId, date])
}

/// Meta ad + creative snapshot (refreshed on sync). Thumbnails/links for performance UI.
model MetaAd {
  id              String   @id @default(cuid())
  tenantId        String
  adId            String
  adName          String   @default("")
  adsetId         String   @default("")
  adsetName       String   @default("")
  campaignId      String   @default("")
  campaignName    String   @default("")
  status          String   @default("")
  effectiveStatus String   @default("")
  creativeId      String   @default("")
  thumbnailUrl    String?
  imageUrl        String?
  /// Ad preview / post permalink when available
  permalinkUrl    String?
  /// Destination / CTA link from creative
  linkUrl         String?
  objectType      String?
  syncedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, adId])
  @@index([tenantId, effectiveStatus])
}

/// Meta ad-level daily insights (paid). Joined with MetaAd for creative UI.
model MetaAdInsight {
  id          String   @id @default(cuid())
  tenantId    String
  date        DateTime @db.Date
  adId        String
  adName      String   @default("")
  campaignId  String   @default("")
  campaignName String  @default("")
  adsetId     String   @default("")
  adsetName   String   @default("")
  spend       Decimal  @default(0) @db.Decimal(14, 2)
  impressions Int      @default(0)
  reach       Int      @default(0)
  clicks      Int      @default(0)
  ctr         Decimal? @db.Decimal(10, 6)
  cpc         Decimal? @db.Decimal(14, 4)
  actions     Json     @default("{}")
  actionValues Json    @default("{}")
  conversions Decimal? @db.Decimal(14, 4)
  convValue   Decimal? @db.Decimal(14, 2)
  cpa         Decimal? @db.Decimal(14, 4)
  roas        Decimal? @db.Decimal(14, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, adId])
  @@index([tenantId, date])
  @@index([tenantId, adId])
}

/// Meta ad set–level daily insights.
model MetaAdsetInsight {
  id           String   @id @default(cuid())
  tenantId     String
  date         DateTime @db.Date
  adsetId      String
  adsetName    String   @default("")
  campaignId   String   @default("")
  campaignName String   @default("")
  spend        Decimal  @default(0) @db.Decimal(14, 2)
  impressions  Int      @default(0)
  reach        Int      @default(0)
  clicks       Int      @default(0)
  ctr          Decimal? @db.Decimal(10, 6)
  cpc          Decimal? @db.Decimal(14, 4)
  actions      Json     @default("{}")
  actionValues Json     @default("{}")
  conversions  Decimal? @db.Decimal(14, 4)
  convValue    Decimal? @db.Decimal(14, 2)
  cpa          Decimal? @db.Decimal(14, 4)
  roas         Decimal? @db.Decimal(14, 4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, adsetId])
  @@index([tenantId, date])
  @@index([tenantId, adsetId])
}

/// Meta account insights broken down (placement / device / age).
model MetaBreakdownInsight {
  id          String   @id @default(cuid())
  tenantId    String
  date        DateTime @db.Date
  /// placement | device | age
  breakdown   String
  /// e.g. facebook, mobile_app, 25-34
  key         String
  spend       Decimal  @default(0) @db.Decimal(14, 2)
  impressions Int      @default(0)
  reach       Int      @default(0)
  clicks      Int      @default(0)
  conversions Decimal? @db.Decimal(14, 4)
  convValue   Decimal? @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, breakdown, key])
  @@index([tenantId, date])
  @@index([tenantId, breakdown])
}

/// Successful billing charges / paid invoices (Meta auto-pay + Google monthly invoices).
model BillingCharge {
  id             String   @id @default(cuid())
  tenantId       String
  provider       Provider
  /// Meta transaction_id or Google invoice id
  externalId     String
  amount         Decimal  @db.Decimal(14, 2)
  currency       String   @default("TRY")
  chargedAt      DateTime
  /// completed | paid
  status         String   @default("completed")
  /// Meta receipt URL (browser); Google uses pdf via download API
  viewUrl        String?
  /// Google invoice number shown on PDF
  invoiceNumber  String?
  /// Google: customers/{cid}/billingSetups/{id}
  billingSetupId String?
  /// Google: for refreshing pdf_url
  issueYear      Int?
  issueMonth     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, externalId])
  @@index([tenantId, chargedAt])
  @@index([tenantId, provider])
}

/// Google Ads GAQL metrics (account/campaign rows).
model GoogleAdsMetric {
  id           String   @id @default(cuid())
  tenantId     String
  date         DateTime @db.Date
  campaignId   String   @default("")
  campaignName String   @default("")
  cost         Decimal  @default(0) @db.Decimal(14, 2)
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  ctr          Decimal? @db.Decimal(10, 6)
  cpc          Decimal? @db.Decimal(14, 4)
  conversions  Decimal  @default(0) @db.Decimal(14, 4)
  convValue    Decimal  @default(0) @db.Decimal(14, 2)
  cpa          Decimal? @db.Decimal(14, 4)
  roas         Decimal? @db.Decimal(14, 4)
  ctrOrigin    MetricOrigin @default(provider)
  cpcOrigin    MetricOrigin @default(provider)
  cpaOrigin    MetricOrigin @default(provider)
  roasOrigin   MetricOrigin @default(derived)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, campaignId])
  @@index([tenantId, date])
}

/// GA4 Data API runReport rows (one dimension breakout per row).
model Ga4Metric {
  id             String   @id @default(cuid())
  tenantId       String
  date           DateTime @db.Date
  dimensionType  String
  dimensionValue String   @default("")
  totalUsers     Int?
  sessions       Int?
  averageSessionDuration Decimal? @db.Decimal(14, 4)
  bounceRate     Decimal? @db.Decimal(10, 6)
  screenPageViewsPerSession Decimal? @db.Decimal(10, 4)
  sessionConversionRate Decimal? @db.Decimal(10, 6)
  purchaseRevenue Decimal? @db.Decimal(14, 2)
  transactions   Int?
  ecommercePurchases Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, dimensionType, dimensionValue])
  @@index([tenantId, date])
  @@index([tenantId, dimensionType])
}

model Conversion {
  id        String         @id @default(cuid())
  tenantId  String
  date      DateTime       @db.Date
  name      String
  source    String
  primary   Boolean        @default(false)
  count     Int            @default(0)
  kind      ConversionKind @default(other)
  /// Same action measured via GA4 import + Ads tag, etc.
  dupeFlag  Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@index([tenantId, kind])
}

model Alert {
  id         String        @id @default(cuid())
  tenantId   String
  type       String
  severity   AlertSeverity
  message    String?
  assigneeId String?
  resolved   Boolean       @default(false)
  history    Json          @default("[]")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignee  User?       @relation("AlertAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  boardCards BoardCard[]

  @@index([tenantId, resolved])
  @@index([tenantId, severity])
}

/// Per metric group sync — one failure does not zero other groups.
model SyncJob {
  id            String     @id @default(cuid())
  tenantId      String
  provider      Provider
  service       String
  /// e.g. campaign_insights, gaql_campaign, ga4_channel, gtm_config
  objective     String     @default("default")
  status        SyncStatus @default(pending)
  lastSuccessAt DateTime?
  error         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, service, objective])
  @@index([tenantId, status])
}
