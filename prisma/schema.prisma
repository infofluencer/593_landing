generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  team
  client
}

enum Provider {
  google
  meta
}

enum TenantType {
  ecommerce
  lead
}

enum AlertSeverity {
  ok
  warn
  critical
  unknown
}

enum ConversionKind {
  whatsapp
  form
  sale
  other
}

enum SyncStatus {
  pending
  running
  success
  error
}

/// provider = API returned the metric; derived = we computed (e.g. CPA = spend/conv).
enum MetricOrigin {
  provider
  derived
}

/// Playwright site tag check — GTM config ≠ tags firing on site.
enum SiteVerifyStatus {
  not_tested
  pass
  fail
  partial
  unknown
  error
}

enum BoardCardPriority {
  low
  normal
  high
  urgent
}

/// Marka notu türü — toplantı isteği "Göreve çevir" ile panoya düşer.
enum BrandNoteKind {
  general
  meeting
  request
  document
  link
}

/// Sosyal medya içerik kartı akışı.
enum ContentPostStatus {
  draft
  design
  review
  published
}

/// Otomatik müşteri raporu sıklığı.
enum ReportFrequency {
  none
  weekly
  monthly
}

/// Toplantı durumu.
enum MeetingStatus {
  planned
  done
  cancelled
}

/// Öneri kutusu — gönderinin türü.
enum SuggestionKind {
  idea
  request
  bug
}

/// Öneri kutusu — admin tarafındaki durum.
enum SuggestionStatus {
  new
  reviewing
  done
  rejected
}

/// Agency-level OAuth / system-user (one row per provider).
/// Tokens NEVER stored raw — secret-store reference only.
model AgencyConnection {
  id              String   @id @default(cuid())
  provider        Provider @unique
  oauthTokenRef   String
  loginCustomerId String?
  businessId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Brand sourced from Meta BM ad accounts (metaAccountId = source of truth).
/// type drives conversion model + which sections render.
model Tenant {
  id                   String          @id @default(cuid())
  slug                 String          @unique
  name                 String
  website              String?
  metaAccountId        String          @unique
  type                 TenantType      @default(lead)
  timezone             String          @default("Europe/Istanbul")
  currency             String          @default("TRY")
  visible              Boolean         @default(true)
  /// Kare kapak — `/uploads/brands/{id}.webp`
  coverUrl             String?
  /// Ajans marka ızgarası sırası (küçük = önce)
  sortOrder            Int             @default(0)
  /// Markanın ajans içi sorumlusu (tablo filtresi + bildirim alıcısı).
  ownerId              String?
  /// Markanın kullanmadığı platformlar (meta | google_ads | ga4 | gtm | gsc) —
  /// senkron atlar, eksik eşleşme/hata uyarı sayılmaz.
  disabledIntegrations String[]        @default([])
  /// Otomatik PDF/e-posta rapor sıklığı (alıcılar: reportEmails, yoksa müşteri kullanıcıları).
  reportFrequency      ReportFrequency @default(none)
  reportEmails         String[]        @default([])
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  owner             User?                  @relation("TenantOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  mapping           TenantMapping?
  thresholds        TenantThreshold?
  siteVerification  SiteVerification?
  memberships       Membership[]
  metaInsights      MetaInsight[]
  metaAds           MetaAd[]
  metaAdInsights    MetaAdInsight[]
  metaAdsetInsights MetaAdsetInsight[]
  metaBreakdowns    MetaBreakdownInsight[]
  googleAdsMetrics  GoogleAdsMetric[]
  billingCharges    BillingCharge[]
  ga4Metrics        Ga4Metric[]
  conversions       Conversion[]
  alerts            Alert[]
  syncJobs          SyncJob[]
  boardCards        BoardCard[]
  budgets           TenantBudget[]
  campaignBudgets   CampaignBudget[]
  campaignAliases   CampaignAlias[]
  syncRuns          SyncRun[]
  auditLogs         AuditLog[]
  hourlySpend       HourlySpend[]
  accountHealth     AccountHealth[]
  notes             BrandNote[]
  contentPosts      ContentPost[]
  setupChecks       SetupCheck[]
  reports           BrandReport[]
  notificationLogs  NotificationLog[]
  meetings          Meeting[]

  @@index([ownerId])
}

/// Marka aylık / günlük plan (İstanbul takvim ayı). Kampanya satırları ayrı.
model TenantBudget {
  id            String   @id @default(cuid())
  tenantId      String
  /// YYYY-MM
  month         String
  monthlyBudget Decimal? @db.Decimal(14, 2)
  dailyBudget   Decimal? @db.Decimal(14, 2)
  /// Aylık planın Google Ads payı
  googleBudget  Decimal? @db.Decimal(14, 2)
  /// Aylık planın Meta Ads payı
  metaBudget    Decimal? @db.Decimal(14, 2)
  note          String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, month])
  @@index([tenantId])
}

/// API'den gelen kampanyaya özel günlük / aylık plan.
model CampaignBudget {
  id            String   @id @default(cuid())
  tenantId      String
  /// YYYY-MM
  month         String
  provider      Provider
  campaignId    String
  campaignName  String   @default("")
  monthlyBudget Decimal? @db.Decimal(14, 2)
  dailyBudget   Decimal? @db.Decimal(14, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, month, provider, campaignId])
  @@index([tenantId, month])
}

/// Kampanya görünen adı — API isminden bağımsız, tüm aylarda geçerli.
model CampaignAlias {
  id         String   @id @default(cuid())
  tenantId   String
  provider   Provider
  campaignId String
  label      String
  sourceName String   @default("")
  /// Planlama — hedef kitle
  audience   String   @default("")
  /// Planlama — çıkılacak konum
  location   String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, campaignId])
  @@index([tenantId])
}

model TenantThreshold {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  budgetPaceWarnPct Int      @default(85)
  convDropoutDays   Int      @default(3)
  minSpendForAlert  Decimal  @default(100) @db.Decimal(14, 2)
  /// Ay içi CPL (lead) / CPA (e-ticaret) hedefi — aşılınca uyarı.
  cplTarget         Decimal? @db.Decimal(14, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Playwright site verification (consent scenarios). Last run only.
model SiteVerification {
  id        String           @id @default(cuid())
  tenantId  String           @unique
  status    SiteVerifyStatus @default(not_tested)
  checkedAt DateTime?
  summary   String?
  /// Per-scenario results: default / accept / reject
  scenarios Json             @default("[]")
  findings  Json             @default("{}")
  error     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Google stack mapped onto a Meta-sourced tenant (nullable = eksik bağlantı).
model TenantMapping {
  id             String  @id @default(cuid())
  tenantId       String  @unique
  adsCustomerId  String?
  ga4PropertyId  String?
  gtmContainerId String?
  gscSiteUrl     String?
  merchantId     String?
  /// Google Ads customer.time_zone (segments.date bu saat dilimindedir).
  adsTimezone    String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  /// Staff-only recoverable copy for agency settings (auth still uses passwordHash).
  passwordPlain String?
  name          String?
  /// WhatsApp bildirimi için E.164 (ör. +905321234567).
  phone         String?
  /// Profil fotoğrafı (/uploads/avatars/{id}.webp?v=…).
  avatarUrl     String?
  role          Role
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships        Membership[]
  assignedAlerts     Alert[]             @relation("AlertAssignee")
  teamMemberships    TeamMember[]
  cardAssignments    BoardCardAssignee[]
  createdCards       BoardCard[]         @relation("CardCreator")
  cardActivities     BoardCardActivity[]
  ownedTenants       Tenant[]            @relation("TenantOwner")
  auditLogs          AuditLog[]
  brandNotes         BrandNote[]         @relation("NoteAuthor")
  contentAssigned    ContentPost[]       @relation("ContentAssignee")
  contentDesigned    ContentPost[]       @relation("ContentDesigner")
  contentCreated     ContentPost[]       @relation("ContentCreator")
  reportsCreated     BrandReport[]
  meetingsCreated    Meeting[]           @relation("MeetingCreator")
  meetingAttendances MeetingAttendee[]
  actionItemAssignments MeetingActionItemAssignee[]
  suggestions        Suggestion[]
  backups            Backup[]            @relation("BackupCreator")
}

/// Ajans içi sabit ekip (src/lib/panel/teams.ts). Üye çoka-çok (TeamMember).
model Team {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  /// Kanban filtre / rozet rengi (hex).
  color       String   @default("#71717a")
  /// Sabit ekip sırası (FIXED_TEAMS).
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  TeamMember[]
  cards    BoardCard[]
  notes    BrandNote[]
  meetings Meeting[]
}

/// TeamMembership — bir kullanıcı birden fazla takımda olabilir.
model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

/// Ajans durum tablosu (Trello tarzı) — tek board, yalnızca staff host.
model Board {
  id        String   @id @default(cuid())
  name      String   @default("Ajans durumu")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  columns BoardColumn[]
}

model BoardColumn {
  id       String  @id @default(cuid())
  boardId  String
  name     String
  position Int
  /// Tailwind-friendly accent hex, e.g. #e91825
  color    String?

  board Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards BoardCard[]

  @@index([boardId, position])
}

model BoardCard {
  id            String            @id @default(cuid())
  columnId      String
  title         String
  description   String?
  position      Int
  priority      BoardCardPriority @default(normal)
  /// Kart hangi takıma ait (filtre / grup).
  teamId        String?
  tenantId      String?
  dueAt         DateTime?
  labels        String[]          @default([])
  /// Referans görselleri (/uploads/board/…). İlki kart kapağı olarak gösterilir.
  images        String[]          @default([])
  sourceAlertId String?
  createdById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  column      BoardColumn         @relation(fields: [columnId], references: [id], onDelete: Cascade)
  team        Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy   User?               @relation("CardCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tenant      Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  sourceAlert Alert?              @relation(fields: [sourceAlertId], references: [id], onDelete: SetNull)
  assignees   BoardCardAssignee[]
  activities  BoardCardActivity[]
  sourceNote  BrandNote?
  contentPost ContentPost?
  actionItem  MeetingActionItem?

  @@index([columnId, position])
  @@index([teamId])
  @@index([tenantId])
  @@index([sourceAlertId])
  @@index([dueAt])
}

/// Kart ↔ staff çoklu atama.
model BoardCardAssignee {
  id        String   @id @default(cuid())
  cardId    String
  userId    String
  createdAt DateTime @default(now())

  card BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cardId, userId])
  @@index([userId])
}

/// Kart durum / atama değişiklikleri (salt okuma audit).
model BoardCardActivity {
  id        String   @id @default(cuid())
  cardId    String
  actorId   String?
  /// created | moved | assigned | unassigned | priority | due | labels | team | tenant | updated
  type      String
  message   String?
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  card  BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  actor User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([cardId, createdAt])
}

model Membership {
  id       String @id @default(cuid())
  userId   String
  tenantId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

/// Meta Marketing API insights (paid only — no Instagram organic).
model MetaInsight {
  id           String       @id @default(cuid())
  tenantId     String
  date         DateTime     @db.Date
  campaignId   String       @default("")
  campaignName String       @default("")
  objective    String       @default("")
  spend        Decimal      @default(0) @db.Decimal(14, 2)
  impressions  Int          @default(0)
  reach        Int          @default(0)
  frequency    Decimal?     @db.Decimal(10, 4)
  clicks       Int          @default(0)
  ctr          Decimal?     @db.Decimal(10, 6)
  cpc          Decimal?     @db.Decimal(14, 4)
  /// action_type → count map (purchase, lead, messaging_…, etc.)
  actions      Json         @default("{}")
  /// action_type → value map (purchase value etc.)
  actionValues Json         @default("{}")
  conversions  Decimal?     @db.Decimal(14, 4)
  convValue    Decimal?     @db.Decimal(14, 2)
  cpa          Decimal?     @db.Decimal(14, 4)
  roas         Decimal?     @db.Decimal(14, 4)
  ctrOrigin    MetricOrigin @default(provider)
  cpcOrigin    MetricOrigin @default(provider)
  cpaOrigin    MetricOrigin @default(derived)
  roasOrigin   MetricOrigin @default(provider)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, campaignId, objective])
  @@index([tenantId, date])
}

/// Meta ad + creative snapshot (refreshed on sync). Thumbnails/links for performance UI.
model MetaAd {
  id              String   @id @default(cuid())
  tenantId        String
  adId            String
  adName          String   @default("")
  adsetId         String   @default("")
  adsetName       String   @default("")
  campaignId      String   @default("")
  campaignName    String   @default("")
  status          String   @default("")
  effectiveStatus String   @default("")
  creativeId      String   @default("")
  thumbnailUrl    String?
  imageUrl        String?
  /// Ad preview / post permalink when available
  permalinkUrl    String?
  /// Destination / CTA link from creative
  linkUrl         String?
  /// Kreatif url_tags (UTM parametreleri) — kurulum kontrolü.
  urlTags         String?
  objectType      String?
  syncedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, adId])
  @@index([tenantId, effectiveStatus])
}

/// Meta ad-level daily insights (paid). Joined with MetaAd for creative UI.
model MetaAdInsight {
  id           String   @id @default(cuid())
  tenantId     String
  date         DateTime @db.Date
  adId         String
  adName       String   @default("")
  campaignId   String   @default("")
  campaignName String   @default("")
  adsetId      String   @default("")
  adsetName    String   @default("")
  spend        Decimal  @default(0) @db.Decimal(14, 2)
  impressions  Int      @default(0)
  reach        Int      @default(0)
  clicks       Int      @default(0)
  ctr          Decimal? @db.Decimal(10, 6)
  cpc          Decimal? @db.Decimal(14, 4)
  actions      Json     @default("{}")
  actionValues Json     @default("{}")
  conversions  Decimal? @db.Decimal(14, 4)
  convValue    Decimal? @db.Decimal(14, 2)
  cpa          Decimal? @db.Decimal(14, 4)
  roas         Decimal? @db.Decimal(14, 4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, adId])
  @@index([tenantId, date])
  @@index([tenantId, adId])
}

/// Meta ad set–level daily insights.
model MetaAdsetInsight {
  id           String   @id @default(cuid())
  tenantId     String
  date         DateTime @db.Date
  adsetId      String
  adsetName    String   @default("")
  campaignId   String   @default("")
  campaignName String   @default("")
  spend        Decimal  @default(0) @db.Decimal(14, 2)
  impressions  Int      @default(0)
  reach        Int      @default(0)
  clicks       Int      @default(0)
  ctr          Decimal? @db.Decimal(10, 6)
  cpc          Decimal? @db.Decimal(14, 4)
  actions      Json     @default("{}")
  actionValues Json     @default("{}")
  conversions  Decimal? @db.Decimal(14, 4)
  convValue    Decimal? @db.Decimal(14, 2)
  cpa          Decimal? @db.Decimal(14, 4)
  roas         Decimal? @db.Decimal(14, 4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, adsetId])
  @@index([tenantId, date])
  @@index([tenantId, adsetId])
}

/// Meta account insights broken down (placement / device / age).
model MetaBreakdownInsight {
  id          String   @id @default(cuid())
  tenantId    String
  date        DateTime @db.Date
  /// placement | device | age
  breakdown   String
  /// e.g. facebook, mobile_app, 25-34
  key         String
  spend       Decimal  @default(0) @db.Decimal(14, 2)
  impressions Int      @default(0)
  reach       Int      @default(0)
  clicks      Int      @default(0)
  conversions Decimal? @db.Decimal(14, 4)
  convValue   Decimal? @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, breakdown, key])
  @@index([tenantId, date])
  @@index([tenantId, breakdown])
}

/// Successful billing charges / paid invoices (Meta auto-pay + Google monthly invoices).
model BillingCharge {
  id             String   @id @default(cuid())
  tenantId       String
  provider       Provider
  /// Meta transaction_id or Google invoice id
  externalId     String
  amount         Decimal  @db.Decimal(14, 2)
  currency       String   @default("TRY")
  chargedAt      DateTime
  /// completed | paid
  status         String   @default("completed")
  /// Meta receipt URL (browser); Google uses pdf via download API
  viewUrl        String?
  /// Google invoice number shown on PDF
  invoiceNumber  String?
  /// Google: customers/{cid}/billingSetups/{id}
  billingSetupId String?
  /// Google: for refreshing pdf_url
  issueYear      Int?
  issueMonth     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, externalId])
  @@index([tenantId, chargedAt])
  @@index([tenantId, provider])
}

/// Google Ads GAQL metrics (account/campaign rows).
model GoogleAdsMetric {
  id             String       @id @default(cuid())
  tenantId       String
  date           DateTime     @db.Date
  campaignId     String       @default("")
  campaignName   String       @default("")
  cost           Decimal      @default(0) @db.Decimal(14, 2)
  impressions    Int          @default(0)
  clicks         Int          @default(0)
  ctr            Decimal?     @db.Decimal(10, 6)
  cpc            Decimal?     @db.Decimal(14, 4)
  conversions    Decimal      @default(0) @db.Decimal(14, 4)
  convValue      Decimal      @default(0) @db.Decimal(14, 2)
  /// metrics.all_conversions — ikincil aksiyonlar dahil (teşhis; KPI'ya girmez).
  allConversions Decimal      @default(0) @db.Decimal(14, 4)
  cpa            Decimal?     @db.Decimal(14, 4)
  roas           Decimal?     @db.Decimal(14, 4)
  ctrOrigin      MetricOrigin @default(provider)
  cpcOrigin      MetricOrigin @default(provider)
  cpaOrigin      MetricOrigin @default(provider)
  roasOrigin     MetricOrigin @default(derived)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, campaignId])
  @@index([tenantId, date])
}

/// GA4 Data API runReport rows (one dimension breakout per row).
model Ga4Metric {
  id                        String   @id @default(cuid())
  tenantId                  String
  date                      DateTime @db.Date
  dimensionType             String
  dimensionValue            String   @default("")
  totalUsers                Int?
  sessions                  Int?
  averageSessionDuration    Decimal? @db.Decimal(14, 4)
  bounceRate                Decimal? @db.Decimal(10, 6)
  screenPageViewsPerSession Decimal? @db.Decimal(10, 4)
  sessionConversionRate     Decimal? @db.Decimal(10, 6)
  purchaseRevenue           Decimal? @db.Decimal(14, 2)
  transactions              Int?
  ecommercePurchases        Int?
  /// GA4 anahtar etkinlik adedi (eski adıyla conversions)
  keyEvents                 Decimal? @db.Decimal(14, 4)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, dimensionType, dimensionValue])
  @@index([tenantId, date])
  @@index([tenantId, dimensionType])
}

/// Google Ads dönüşüm aksiyonu × gün (segments.date). Meta türleri MetaInsight.actions'tan türetilir.
model Conversion {
  id        String         @id @default(cuid())
  tenantId  String
  date      DateTime       @db.Date
  name      String
  source    String
  /// Panel KPI'sına sayılıyor mu (marka tipine göre countsAsPanelConversion).
  primary   Boolean        @default(false)
  /// Veri temelli atıf kesirli dağıtır — tam sayıya yuvarlanmaz.
  count     Decimal        @default(0) @db.Decimal(14, 4)
  value     Decimal        @default(0) @db.Decimal(14, 2)
  /// Google Ads conversion_action_category (PURCHASE, SUBMIT_LEAD_FORM…)
  category  String?
  kind      ConversionKind @default(other)
  /// Same action measured via GA4 import + Ads tag, etc.
  dupeFlag  Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@index([tenantId, kind])
}

model Alert {
  id               String         @id @default(cuid())
  tenantId         String
  type             String
  severity         AlertSeverity
  message          String?
  assigneeId       String?
  resolved         Boolean        @default(false)
  history          Json           @default("[]")
  /// Şablon parametreleri (platform, tutar, gün sayısı…) — bildirim metni buradan kurulur.
  details          Json          @default("{}")
  /// Son bildirim (WhatsApp / e-posta) — aynı seviyede tekrar gönderilmez.
  notifiedAt       DateTime?
  notifiedSeverity AlertSeverity?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignee      User?             @relation("AlertAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  boardCards    BoardCard[]
  notifications NotificationLog[]

  @@index([tenantId, resolved])
  @@index([tenantId, severity])
}

/// Per metric group sync — one failure does not zero other groups.
model SyncJob {
  id            String     @id @default(cuid())
  tenantId      String
  provider      Provider
  service       String
  /// e.g. campaign_insights, gaql_campaign, ga4_channel, gtm_config
  objective     String     @default("default")
  status        SyncStatus @default(pending)
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  error         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, service, objective])
  @@index([tenantId, status])
}

/// Senkron birimi geçmişi — SyncJob yalnızca son durumu tutar.
model SyncRun {
  id         String     @id @default(cuid())
  tenantId   String
  provider   Provider
  service    String
  objective  String     @default("default")
  status     SyncStatus
  error      String?
  startedAt  DateTime?
  finishedAt DateTime   @default(now())
  durationMs Int?
  /// manual | retry | cron | backfill
  trigger    String     @default("manual")
  /// Manuel / yeniden dene tetikleyen kullanıcı (cron'da boş).
  actorEmail String?
  /// Geçici hatada yeniden deneme dahil toplam deneme.
  attempts   Int        @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, finishedAt])
  @@index([finishedAt])
  @@index([status, finishedAt])
}

/// Kim, neyi, ne zaman değiştirdi (bütçe, plan, marka, kullanıcı, ekip).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  /// Kullanıcı silinse de iz kalsın.
  actorEmail String?
  /// örn. budget.update, tenant.update, user.delete
  action     String
  /// tenant | budget | campaign_budget | user | team | board_card
  entity     String
  entityId   String?
  tenantId   String?
  summary    String   @default("")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@index([entity, entityId])
}

/// Bugünün saatlik harcaması (Meta: reklamveren saat dilimi, Google: hesap saat dilimi).
/// Saatlik senkron günü baştan yazar; geçmiş günler için günlük tablolar esastır.
model HourlySpend {
  id          String   @id @default(cuid())
  tenantId    String
  provider    Provider
  date        DateTime @db.Date
  /// 0–23
  hour        Int
  spend       Decimal  @default(0) @db.Decimal(14, 2)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, date, hour])
  @@index([date])
}

/// Reklam hesabı / ödeme durumu — saatlik kontrol, son durum.
model AccountHealth {
  id        String   @id @default(cuid())
  tenantId  String
  provider  Provider
  /// ok | warn | critical | unknown
  status    String
  /// Kısa Türkçe etiket (ör. "Ödenmemiş bakiye")
  label     String
  detail    String?
  /// Ham API alanları (account_status, disable_reason, bütçe vb.)
  raw       Json     @default("{}")
  checkedAt DateTime @default(now())
  /// Durum en son ne zaman değişti (bildirim tekrarını önlemek için).
  changedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
}

/// Marka notları — toplantı notu, anlık istek, doküman / URL. Tüm ekip görür.
model BrandNote {
  id          String        @id @default(cuid())
  tenantId    String
  authorId    String?
  /// Kullanıcı silinse de yazar kalsın.
  authorEmail String?
  kind        BrandNoteKind @default(general)
  title       String        @default("")
  body        String        @default("")
  url         String?
  /// Toplantı notunun ait olduğu toplantı tarihi.
  meetingAt   DateTime?
  /// İstek hangi ekibi ilgilendiriyor ("Göreve çevir" kartı bu ekibe düşer).
  teamId      String?
  /// "Göreve çevir" ile açılan Durum kartı.
  boardCardId String?       @unique
  pinned      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author    User?      @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  team      Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  boardCard BoardCard? @relation(fields: [boardCardId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

/// Sosyal medya yayın takvimi kartı — Grafik Tasarım + Sosyal Medya aynı kartta.
/// Ajans toplantısı. tenantId dolu → marka toplantısı; teamId dolu → ekip
/// toplantısı; ikisi de boş → ajans geneli. Katılımcı ve not yazarı yalnızca
/// staff (admin/team) — müşteri kullanıcıları dahil edilmez.
model Meeting {
  id          String        @id @default(cuid())
  title       String
  tenantId    String?
  teamId      String?
  startsAt    DateTime
  endsAt      DateTime?
  /// Google Meet linki, ofis, vb.
  location    String?
  status      MeetingStatus @default(planned)
  /// Gündem (markdown / düz metin).
  agenda      String        @default("")
  /// Toplantı notları.
  notes       String        @default("")
  /// Alınan kararlar.
  decisions   String        @default("")
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant      Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  team        Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy   User?               @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  attendees   MeetingAttendee[]
  actionItems MeetingActionItem[]

  @@index([tenantId, startsAt])
  @@index([teamId, startsAt])
  @@index([startsAt])
}

/// Toplantı katılımcısı — yalnızca staff kullanıcı.
model MeetingAttendee {
  id        String   @id @default(cuid())
  meetingId String
  userId    String
  createdAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId])
}

/// Toplantıda çıkan aksiyon maddesi; "Göreve çevir" ile Durum panosu kartına bağlanır.
model MeetingActionItem {
  id          String    @id @default(cuid())
  meetingId   String
  text        String
  dueAt       DateTime?
  done        Boolean   @default(false)
  position    Int       @default(0)
  boardCardId String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  meeting   Meeting                     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignees MeetingActionItemAssignee[]
  boardCard BoardCard?                  @relation(fields: [boardCardId], references: [id], onDelete: SetNull)

  @@index([meetingId, position])
}

model MeetingActionItemAssignee {
  id        String   @id @default(cuid())
  itemId    String
  userId    String
  createdAt DateTime @default(now())

  item MeetingActionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([userId])
}

model ContentPost {
  id          String            @id @default(cuid())
  tenantId    String
  title       String            @default("")
  /// instagram | facebook | tiktok | linkedin | x | youtube
  platform    String            @default("instagram")
  scheduledAt DateTime
  status      ContentPostStatus @default(draft)
  brief       String            @default("")
  caption     String            @default("")
  /// Görsel / video linkleri (Drive, CDN vb.).
  mediaUrls   String[]          @default([])
  assigneeId  String?
  designerId  String?
  createdById String?
  /// Tasarım görevi (Durum panosu).
  boardCardId String?           @unique
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignee  User?      @relation("ContentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  designer  User?      @relation("ContentDesigner", fields: [designerId], references: [id], onDelete: SetNull)
  createdBy User?      @relation("ContentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  boardCard BoardCard? @relation(fields: [boardCardId], references: [id], onDelete: SetNull)

  @@index([tenantId, scheduledAt])
  @@index([scheduledAt])
}

/// Otomatik kurulum kontrolü (UTM, GA4 key event, Pixel/CAPI, Ads dönüşüm).
model SetupCheck {
  id        String   @id @default(cuid())
  tenantId  String
  /// utm | ga4_key_event | meta_pixel | meta_capi | google_ads_conversion
  key       String
  /// ok | missing | unknown
  status    String
  detail    String?
  /// Ajans elle onayladı — otomatik kontrol üzerine yazmaz.
  manual    Boolean  @default(false)
  checkedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

/// Müşteriye gönderilen / indirilen PDF rapor (ajans yorumu ile).
model BrandReport {
  id             String    @id @default(cuid())
  tenantId       String
  from           DateTime  @db.Date
  to             DateTime  @db.Date
  comment        String    @default("")
  createdById    String?
  createdByEmail String?
  /// cron | manual
  trigger        String    @default("manual")
  sentTo         String[]  @default([])
  sentAt         DateTime?
  error          String?
  createdAt      DateTime  @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

/// Bildirim gönderim kaydı (WhatsApp / e-posta).
model NotificationLog {
  id        String   @id @default(cuid())
  tenantId  String?
  alertId   String?
  /// whatsapp | email
  channel   String
  recipient String
  template  String?
  /// sent | failed | skipped
  status    String
  error     String?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  alert  Alert?  @relation(fields: [alertId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([alertId])
}

/// Sistemle ilgili öneri / istek / hata bildirimi. Yalnızca admin görür.
/// Anonim gönderide authorId hiç yazılmaz (admin de göremez).
model Suggestion {
  id        String           @id @default(cuid())
  kind      SuggestionKind   @default(idea)
  body      String
  status    SuggestionStatus @default(new)
  authorId  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

/// Panel içi verilerin (durum panosu, notlar, toplantılar, içerik takvimi,
/// öneriler) JSON anlık görüntüsü. Dosya S3’te `backups/<id>.json`.
model Backup {
  id             String   @id @default(cuid())
  /// manual | cron
  trigger        String   @default("manual")
  createdById    String?
  /// Kullanıcı silinse de kim aldığı kalsın.
  createdByEmail String?
  /// Bölüm → kayıt sayısı, ör. { "cards": 120, "notes": 30 }.
  counts         Json     @default("{}")
  sizeBytes      Int      @default(0)
  createdAt      DateTime @default(now())

  createdBy User? @relation("BackupCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
