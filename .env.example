SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@593emarketing.com
SMTP_PASS=
CONTACT_TO=info@593emarketing.com

# --- Panel (Faz 0+) ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/agency_593
AUTH_SECRET=
# Multi-tenant: do NOT set AUTH_URL to a fixed host (breaks *.localhost / subdomains).
AUTH_TRUST_HOST=true
ROOT_DOMAIN=593emarketing.com

# auto = token yoksa mock; mock | live
PANEL_DATA_MODE=auto

# Google (agency-level OAuth — one connection for all tenants)
# Scopes typically: adwords, analytics.readonly, tagmanager.readonly,
# webmasters.readonly, content (Merchant)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_REFRESH_TOKEN=

# Meta (agency-level system user — BM is tenant source of truth)
# Needs ads_read / business_management; App Review may be required for production
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=
META_SYSTEM_USER_TOKEN=

# Faz 3 — Playwright site tag verification
# npm run playwright:install
# SITE_VERIFY_ON_SYNC=true → tüm marka sync’inde site testi (yavaş; varsayılan kapalı)
# “Veriyi yenile” yalnızca API sync yapar; site testi GTM sayfasındaki ayrı buton
SITE_VERIFY_ON_SYNC=false
